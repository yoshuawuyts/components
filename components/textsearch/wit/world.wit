package yosh:textsearch;

world textsearch {
    /// A single match found in the haystack.
    record match {
        /// 1-based line number of the line containing the match.
        line-number: u64,
        /// The text of the line containing the match, with any trailing
        /// line terminator removed.
        line: string,
        /// Byte offset of the match start within the line.
        column-start: u32,
        /// Byte offset of the match end (exclusive) within the line.
        column-end: u32,
        /// The substring of the line that matched the pattern.
        text: string,
    }

    /// Options controlling how the pattern is interpreted.
    record options {
        /// Match the pattern case-insensitively.
        case-insensitive: bool,
        /// Treat the pattern as a fixed literal string instead of a regex.
        fixed-strings: bool,
        /// Only match the pattern when it is bounded by word boundaries.
        word: bool,
        /// Allow the regex `.` to match newline characters and enable
        /// matches spanning multiple lines.
        multiline: bool,
    }

    /// A single file supplied to a multi-file operation.
    ///
    /// The component does not access the host filesystem; callers are
    /// expected to enumerate files and read their contents themselves.
    /// `path` is treated as an opaque label that is echoed back in the
    /// results so callers can correlate matches with their source.
    record file {
        /// Caller-supplied identifier for this file (typically a path).
        path: string,
        /// The contents of the file to be searched.
        contents: string,
    }

    /// All matches found within a single input file.
    record file-matches {
        /// The `path` of the input file these matches came from.
        path: string,
        /// Every match in the file, in document order.
        matches: list<match>,
    }

    /// The rewritten contents of a single input file.
    record file-replacement {
        /// The `path` of the input file.
        path: string,
        /// The file's contents after applying the replacement.
        contents: string,
    }

    /// Search `haystack` for all matches of the regex `pattern`, in the
    /// same style as `ripgrep`. Returns one record per match.
    export search: func(
        pattern: string,
        haystack: string,
        options: options,
    ) -> result<list<match>, string>;

    /// Replace every match of the regex `pattern` in `haystack` with
    /// `replacement`. The replacement string may reference capture groups
    /// with `$1`, `${name}`, and so on, matching the syntax accepted by
    /// `ripgrep --replace`.
    export replace: func(
        pattern: string,
        replacement: string,
        haystack: string,
        options: options,
    ) -> result<string, string>;

    /// Search each file in `files` for all matches of the regex `pattern`.
    ///
    /// Returns one `file-matches` record per input file, in the same order
    /// as `files`. Files with no matches are omitted from the result, so
    /// callers can iterate the result directly without filtering.
    export search-files: func(
        pattern: string,
        files: list<file>,
        options: options,
    ) -> result<list<file-matches>, string>;

    /// Replace every match of the regex `pattern` in each file's contents
    /// with `replacement`.
    ///
    /// Returns one `file-replacement` record per input file, in the same
    /// order as `files`. Files whose contents are unchanged are omitted
    /// from the result, mirroring the behaviour of `rg --replace` over a
    /// directory.
    export replace-files: func(
        pattern: string,
        replacement: string,
        files: list<file>,
        options: options,
    ) -> result<list<file-replacement>, string>;
}
