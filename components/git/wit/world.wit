package yoshuawuyts:git@0.1.0;

/// Self-contained local Git operations. Paths are WASI-visible repository paths.
interface repository {
    /// Explicit author/committer identity; no host Git configuration is required.
    record signature {
        name: string,
        email: string,
        seconds: s64,
        offset: s32,
    }

    /// A decoded commit. Message bytes are preserved without UTF-8 conversion.
    record commit-record {
        id: string,
        tree: string,
        parents: list<string>,
        author: signature,
        committer: signature,
        message: list<u8>,
    }

    /// A leaf entry in a recursive tree listing.
    record entry {
        path: string,
        id: string,
        mode: u32,
    }

    /// A named reference and its peeled object identifier.
    record reference {
        name: string,
        id: string,
    }

    /// File modes accepted when creating commits.
    enum file-mode {
        regular,
        executable,
        symlink,
    }

    /// Insert/replace a blob, or remove a path when contents is none.
    record change {
        path: string,
        contents: option<list<u8>>,
        mode: file-mode,
    }

    /// Tree-level difference. No rename inference or text conversion is applied.
    record difference {
        path: string,
        before: option<entry>,
        after: option<entry>,
    }

    /// A tree change with optional exact-content rename inference.
    record file-difference {
        before: option<entry>,
        after: option<entry>,
        renamed: bool,
    }

    /// Bounds for raw-object unified patches; no attributes or external drivers are used.
    record patch-options {
        /// Symmetric hunk context, 0..=100.
        context-lines: u32,
        /// Maximum changed files, 1..=1000. Exceeding a bound fails the whole call.
        max-files: u32,
        /// Maximum total patch bytes, 1..=16777216.
        max-bytes: u32,
        /// Pair deleted/added paths with identical blob IDs and compatible file types.
        detect-renames: bool,
    }

    /// One file's metadata and Git-format patch bytes (including headers).
    record file-patch {
        difference: file-difference,
        /// NUL-containing blobs are binary. Changed binary contents produce a
        /// diagnostic, not an applicable binary delta; exact renames remain applicable.
        binary: bool,
        patch: list<u8>,
    }

    /// Attribution of a requested one-based line to its introducing commit.
    record blame-line {
        line-number: u32,
        commit: string,
        original-path: string,
        original-line: u32,
    }

    /// Bounds for linear-history blame, including exact-content renames.
    record blame-options {
        /// One-based starting line; 1 is also accepted for an empty file.
        start-line: u32,
        /// Maximum requested lines, 1..=100000.
        max-lines: u32,
        /// Maximum visited commits, 1..=1000. Unresolved attribution fails.
        max-commits: u32,
    }

    /// The kind of a staged or unstaged path change.
    enum change-kind {
        added,
        modified,
        removed,
        type-changed,
    }

    /// A path's staged and unstaged state. Untracked files have no staged or unstaged kind.
    record file-status {
        path: string,
        staged: option<change-kind>,
        unstaged: option<change-kind>,
        untracked: bool,
    }

    /// An unresolved path reported by a merge.
    record merge-conflict {
        path: string,
    }

    /// The commit replay and paths that prevented a rebase from completing.
    record rebase-conflict {
        commit: string,
        paths: list<string>,
    }

    /// The final tip and rewritten commit identifiers after a rebase.
    record rebase-success {
        tip: string,
        commits: list<string>,
    }

    /// Credentials supplied for one network operation. They are never read from or written to the environment or Git config.
    record network-credentials {
        /// Username for HTTP Basic authentication; must be paired with `password`.
        username: option<string>,
        /// Password for HTTP Basic authentication; must be paired with `username`.
        password: option<string>,
        /// Bearer token for HTTP authentication; mutually exclusive with Basic credentials.
        bearer-token: option<string>,
    }

    /// Bounds and optional explicit authentication for one smart-HTTP operation.
    record network-options {
        /// Maximum total bytes in any HTTP response, including protocol framing; 1..=268435456.
        max-response-bytes: u64,
        /// Maximum decoded pack bytes; 1..=268435456. Packs are also limited to
        /// 1,000,000 objects.
        max-pack-bytes: u64,
        /// Maximum remote references to accept; 1..=100000.
        max-refs: u32,
        /// Exact hostnames this operation may contact; no wildcards or implicit hosts.
        /// The WASI HTTP runtime must separately grant outgoing network access.
        allowed-hosts: list<string>,
        /// Optional credentials used only for this call.
        credentials: option<network-credentials>,
    }

    /// The result of cloning a remote into a bare repository.
    record clone-result {
        /// The advertised default branch, without the `refs/heads/` prefix.
        default-branch: string,
        /// Remote branches and tags installed by the clone.
        references: list<reference>,
    }

    /// The result of fetching remote references.
    record fetch-result {
        /// Remote-tracking branches updated and tags newly created by this fetch.
        updated: list<reference>,
    }

    /// A network-specific failure. Messages never include credentials or authorization headers.
    variant network-error {
        authentication-required,
        http-status(u16),
        response-too-large,
        malformed-response(string),
        transport-failure,
    }

    /// The result of merging two branches.
    variant merge-result {
        /// The source was already contained in the target.
        up-to-date(string),
        /// The target was advanced directly to the source tip.
        fast-forward(string),
        /// A two-parent merge commit was created.
        merged(string),
        /// No reference was updated because these paths need resolution.
        conflicts(list<merge-conflict>),
    }

    /// The result of replaying a branch onto a new base.
    variant rebase-result {
        /// The branch was updated and commits lists the rewritten commits in replay order.
        rebased(rebase-success),
        /// No reference was updated because this commit could not be replayed cleanly.
        conflicts(rebase-conflict),
    }

    /// All failures are returned explicitly, including corrupt repositories.
    variant error {
        invalid-input(string),
        repository(string),
        unsupported(string),
        conflict(string),
        network(network-error),
    }

    /// Initialize a new bare repository. Refuses an existing destination.
    init: func(path: string, branch: string) -> result<_, error>;

    /// Resolve a Git revision expression to an object identifier.
    /// Colon-leading expressions (including index lookups) are unsupported.
    resolve: func(path: string, revision: string) -> result<string, error>;

    /// List references, peeling annotated tags to their targets.
    references: func(path: string) -> result<list<reference>, error>;

    /// Read at most limit commits along the first-parent chain (1..=1000).
    log: func(path: string, revision: string, limit: u32) -> result<list<commit-record>, error>;

    /// Recursively list leaves in a revision's tree, sorted by path.
    list-tree: func(path: string, revision: string) -> result<list<entry>, error>;

    /// Read raw blob bytes from a revision; symlinks return their target bytes.
    read-file: func(path: string, revision: string, file: string) -> result<list<u8>, error>;

    /// Compare two revision trees, including file-mode changes.
    diff: func(path: string, before: string, after: string) -> result<list<difference>, error>;

    /// Compare trees with deterministic exact-content rename detection.
    /// Ambiguous candidates pair in path order; edited renames and copies are not inferred.
    diff-renames: func(path: string, before: string, after: string, max-files: u32)
        -> result<list<file-difference>, error>;

    /// Emit unified raw-byte patches, including modes, quoted paths and EOF markers.
    /// Each blob is limited to 16 MiB/100000 lines, and total loaded blobs to 64 MiB.
    /// Submodules are unsupported. Binary content changes are explicitly diagnostic-only.
    unified-diff: func(path: string, before: string, after: string, options: patch-options)
        -> result<list<file-patch>, error>;

    /// Attribute raw text lines through linear history and unambiguous clean renames.
    /// Merge traversal, binary files and ambiguous rename origins are unsupported.
    /// Limits: 16 MiB/100000 lines per blob, 64 MiB total loaded blobs and
    /// 1000000 total tree entries. No partial/boundary attribution is returned.
    blame: func(path: string, revision: string, file: string, options: blame-options)
        -> result<list<blame-line>, error>;

    /// Create a branch at a commit; never overwrite an existing reference.
    create-branch: func(path: string, branch: string, revision: string) -> result<_, error>;

    /// Switch a working repository to a branch or commit.
    /// Refuses to overwrite modified tracked or colliding untracked files unless force is true.
    checkout: func(path: string, revision: string, force: bool) -> result<_, error>;

    /// Return staged, unstaged, and untracked paths. Untracked files honor Git ignore rules.
    status: func(path: string) -> result<list<file-status>, error>;

    /// Stage existing files from the working tree into the index.
    add: func(path: string, paths: list<string>) -> result<_, error>;

    /// Remove unchanged tracked files from the working tree and stage deletion.
    /// Refuses to remove paths with unstaged working-tree changes.
    remove: func(path: string, paths: list<string>) -> result<_, error>;

    /// Reset paths in the index to `HEAD`, leaving working-tree files untouched.
    reset: func(path: string, paths: list<string>) -> result<_, error>;

    /// Create a commit from the index and update the currently checked-out branch.
    /// expected-parent is HEAD's current commit, or none for an unborn branch.
    commit: func(
        path: string,
        expected-parent: option<string>,
        author: signature,
        message: string,
    ) -> result<string, error>;

    /// Atomically commit explicit file changes to a branch in a bare repository.
    /// expected-parent is the branch's current commit, or none for a new branch.
    /// Rejects stale parents, empty changes, duplicate paths, and no-op commits.
    /// No index, working tree, hooks, filters, or external programs are involved.
    commit-files: func(
        path: string,
        branch: string,
        expected-parent: option<string>,
        changes: list<change>,
        author: signature,
        message: string,
    ) -> result<string, error>;

    /// Merge source-branch into target-branch using fast-forward or three-way semantics.
    /// Both expected tips are full object identifiers. Histories are bounded to 1000
    /// reachable commits per tip. Conflicts return affected paths without updating the
    /// target reference. Writes require a bare repository.
    merge-branch: func(
        path: string,
        target-branch: string,
        source-branch: string,
        expected-target-tip: string,
        expected-source-tip: string,
        committer: signature,
        message: string,
    ) -> result<merge-result, error>;

    /// Replay the linear history of branch onto new-base, preserving authors and messages
    /// and using the supplied committer for every rewritten commit. expected-tip is the
    /// branch's current full object identifier; new-base is a full commit identifier.
    /// Conflicts include the source commit and paths and never update the branch reference.
    /// At most 1000 commits are replayed; merge commits are unsupported. Writes require
    /// a bare repository.
    rebase-branch: func(
        path: string,
        branch: string,
        expected-tip: string,
        new-base: string,
        committer: signature,
    ) -> result<rebase-result, error>;

    /// Clone a smart-HTTP(S) remote into a new bare repository.
    /// Only `http` and `https` URLs without userinfo are accepted. Authentication is explicit.
    /// The URL hostname must be listed in `options.allowed-hosts`; the WASI HTTP
    /// runtime must independently grant network access. Responses, references,
    /// and packs are bounded by `options`; pack checksums and objects are verified.
    clone: func(
        path: string,
        url: string,
        remote-name: string,
        options: network-options,
    ) -> result<clone-result, error>;

    /// Fetch from a configured remote in a bare repository and update only its remote-tracking
    /// refs (plus missing tags). Local branches and working-tree files are never changed.
    /// Ref updates use lock-file CAS.
    fetch: func(
        path: string,
        remote-name: string,
        options: network-options,
    ) -> result<fetch-result, error>;
}

/// A callable Git client, requiring only standard WASI capabilities.
world git {
    import wasi:http/outgoing-handler@0.2.0;
    export repository;
}
